# AppArmor profile for LocalSend on Ubuntu Touch.
#
# Do NOT declare @{HOME}, @{CLICK_DIR} or @{APP_PKGNAME}: aa-clickhook
# (invoked by click-review) prepends these variables. Redeclaring them
# makes apparmor_parser fail with 'variable ... already declared'.

# The main binary inside the click.
@{CLICK_DIR}/usr/bin/localsend.ahmadabdelbary mr,

# LocalSend uses TCP for transfers, UDP multicast for discovery.
network inet,
network inet6,

# App-private directories (see platform/filesystem.rs).
owner @{HOME}/.config/localsend.ahmadabdelbary/** rw,
owner @{HOME}/.local/share/localsend.ahmadabdelbary/** rw,
owner @{HOME}/.cache/localsend.ahmadabdelbary/** rw,
